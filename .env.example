# The Hub - Environment Configuration Example
# Copy this file to .env and configure for your installation
# IMPORTANT: Never commit .env file with actual credentials to version control!

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_URL=https://hub.yourdomain.com
APP_ENV=production
DEBUG_MODE=false
MAX_UPLOAD_SIZE=10
MAINTENANCE_MODE=false

# ============================================
# AUTHENTICATION & LOGIN
# ============================================
# Enable/disable authentication methods
# ALLOW_LOCAL_USERS: Allow username/password authentication
# ENABLE_GOOGLE_LOGIN: Allow Google OAuth authentication
# ENABLE_MICROSOFT_LOGIN: Allow Microsoft OAuth authentication
ALLOW_LOCAL_USERS=true
REQUIRE_DOMAIN_MATCH=false
ALLOWED_DOMAINS=yourdomain.com
SESSION_TIMEOUT=2

# Google OAuth & Groups
# Get OAuth credentials from: https://console.cloud.google.com/apis/credentials
ENABLE_GOOGLE_LOGIN=true
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx
GOOGLE_REDIRECT_URI=https://hub.yourdomain.com/google_login.php
# Auto-approve users based on Google Workspace group membership (requires service account)
ENABLE_GOOGLE_GROUPS=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_ADMIN_EMAIL=admin@yourdomain.com
GOOGLE_SERVICE_ACCOUNT_JSON=config/service-account-key.json
# Format: group@domain.com:role1,role2|anothergroup@domain.com:role3
# Supports wildcards: seniors*@domain.com matches seniors2026@domain.com, seniors2027@domain.com, etc.
# Examples:
#   students@domain.com:staff
#   seniors*@domain.com:staff,manager
#   teachers@domain.com:manager,admin|staff@domain.com:staff
GOOGLE_GROUP_ROLE_ASSOCIATIONS=students@domain.com:staff|staff@domain.com:manager

# Microsoft OAuth & Groups
# Get OAuth credentials from: https://portal.azure.com > App registrations
ENABLE_MICROSOFT_LOGIN=false
MICROSOFT_CLIENT_ID=your-app-id-here
MICROSOFT_CLIENT_SECRET=your-client-secret-here
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=https://hub.yourdomain.com/microsoft_login.php
# Auto-approve users based on Azure AD group membership
ENABLE_MICROSOFT_GROUPS=false
MICROSOFT_ADMIN_EMAIL=admin@yourdomain.com
MICROSOFT_GROUP_ROLE_ASSOCIATIONS=group-id-1:viewer|group-id-2:user

# ============================================
# EMAIL CONFIGURATION (SMTP)
# ============================================
# For sending invitation emails, password resets, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=The Hub
SMTP_ENCRYPTION=tls

# ============================================
# SECURITY
# ============================================
# Session secret for encrypting session data (generate random string)
SESSION_SECRET=generate_random_secret_here

# ============================================
# LEGACY/DEPRECATED (kept for backwards compatibility)
# ============================================
DB_PASS=your_database_password
SESSION_LIFETIME=7200
SUPER_ADMIN_EMAIL=admin@yourdomain.com

# ============================================
# FIRST-TIME SETUP GUIDE
# ============================================
# 1. Copy this file to .env
# 2. Configure database settings (DB_HOST, DB_NAME, DB_USER, DB_PASSWORD)
# 3. Keep ALLOW_LOCAL_USERS=true initially to create local accounts
# 4. Run database migrations: php cli/migrate.php && php cli/migrate-modules.php && php cli/migrate-sections.php
# 5. Access the application and create your first super admin user
# 6. Configure OAuth settings (Google/Microsoft) in Admin Panel → Site Settings → Advanced
# 7. Toggle authentication methods as needed (Local/Google/Microsoft can be used together)
# 8. Configure additional settings through Admin Panel as needed
