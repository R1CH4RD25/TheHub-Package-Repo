        },
        "mutations": {
            "createVehicle": {
                "description": "Add a new vehicle to the fleet",
                "handler": "VehicleMutationHandler::createVehicle",
                "type": "create",
                "table": "vm_vehicles",
                "fields": [
                    "unit_number",
                    "name",
                    "vin",
                    "license_plate",
                    "year",
                    "make",
                    "model",
                    "color",
                    "current_odometer",
                    "department_id",
                    "campus_id",
                    "assigned_driver_id",
                    "is_shared"
                ],
                "generatedId": "ulid",
                "timestamps": {
                    "created_at": true,
                    "created_by": "user.id"
                },
                "audit": true
            },
            "updateVehicle": {
                "description": "Update vehicle information",
                "handler": "VehicleMutationHandler::updateVehicle",
                "type": "update",
                "table": "vm_vehicles",
                "idColumn": "id",
                "fields": [
                    "unit_number",
                    "name",
                    "vin",
                    "license_plate",
                    "year",
                    "make",
                    "model",
                    "color",
                    "current_odometer",
                    "department_id",
                    "campus_id",
                    "assigned_driver_id",
                    "is_shared"
                ],
                "timestamps": {
                    "updated_at": true,
                    "updated_by": "user.id"
                },
                "audit": true
            },
            "toggleOOS": {
                "description": "Toggle out-of-service status with reason",
                "handler": "VehicleMutationHandler::toggleOOS",
                "type": "toggle",
                "table": "vm_vehicles",
                "idColumn": "id",
                "toggleField": "is_out_of_service",
                "additionalFields": [
                    "out_of_service_reason",
                    "out_of_service_date"
                ],
                "timestamps": {
                    "updated_at": true,
                    "updated_by": "user.id"
                },
                "audit": true
            },
            "createFuelLog": {
                "description": "Submit a new fuel log entry",
                "handler": "FuelMutationHandler::createFuelLog",
                "type": "create",
                "table": "vm_fuel_logs",
                "fields": [
                    "vehicle_id",
                    "trip_category_id",
                    "event_date",
                    "odometer",
                    "gallons",
                    "fuel_type",
                    "is_purchase",
                    "vendor",
                    "location",
                    "total_cost",
                    "price_per_gallon",
                    "notes"
                ],
                "generatedId": "ulid",
                "defaults": {
                    "workflow_status": "submitted"
                },
                "timestamps": {
                    "created_at": true,
                    "logged_by": "user.id"
                },
                "audit": true
            },
            "approveFuelLog": {
                "description": "Approve a fuel log (Layer 2)",
                "handler": "FuelMutationHandler::approveFuelLog",
                "type": "status",
                "table": "vm_fuel_logs",
                "idColumn": "id",
                "statusField": "workflow_status",
                "targetStatus": "approved",
                "validFromStatuses": [
                    "submitted",
                    "in_review",
                    "resubmitted"
                ],
                "timestamps": {
                    "reviewed_at": true,
                    "reviewed_by": "user.id"
                },
                "audit": true
            },
            "rejectFuelLog": {
                "description": "Reject a fuel log with reason (Layer 2)",
                "handler": "FuelMutationHandler::rejectFuelLog",
                "type": "status",
                "table": "vm_fuel_logs",
                "idColumn": "id",
                "statusField": "workflow_status",
                "targetStatus": "rejected",
                "validFromStatuses": [
                    "submitted",
                    "in_review",
                    "resubmitted"
                ],
                "additionalFields": [
                    "review_notes"
                ],
                "timestamps": {
                    "reviewed_at": true,
                    "reviewed_by": "user.id"
                },
                "audit": true,
                "confirm": true
            },
            "returnFuelLog": {
                "description": "Return fuel log for correction with reason (Layer 2)",
                "handler": "FuelMutationHandler::returnFuelLog",
                "type": "status",
                "table": "vm_fuel_logs",
                "idColumn": "id",
                "statusField": "workflow_status",
                "targetStatus": "needs_correction",
                "validFromStatuses": [
                    "submitted",
                    "in_review",
                    "resubmitted"
                ],
                "additionalFields": [
                    "correction_reason"
                ],
                "timestamps": {
                    "reviewed_at": true,
                    "reviewed_by": "user.id"
                },
                "audit": true
            },
            "createMaintenanceEvent": {
                "description": "Submit a maintenance event",
                "handler": "MaintenanceMutationHandler::createMaintenanceEvent",
                "type": "create",
                "table": "vm_maintenance_events",
                "fields": [
                    "vehicle_id",
                    "maintenance_item_id",
                    "event_date",
                    "odometer",
                    "vendor",
                    "parts_cost",
                    "labor_cost",
                    "total_cost",
                    "notes"
                ],
                "generatedId": "ulid",
                "defaults": {
                    "workflow_status": "submitted"
                },
                "timestamps": {
                    "created_at": true,
                    "logged_by": "user.id"
                },
                "audit": true
            },
            "approveMaintenanceEvent": {
                "description": "Approve a maintenance event (Layer 2)",
                "handler": "MaintenanceMutationHandler::approveMaintenanceEvent",
                "type": "status",
                "table": "vm_maintenance_events",
                "idColumn": "id",
                "statusField": "workflow_status",
                "targetStatus": "approved",
                "validFromStatuses": [
                    "submitted",
                    "in_review",
                    "resubmitted"
                ],
                "timestamps": {
                    "reviewed_at": true,
                    "reviewed_by": "user.id"
                },
                "audit": true
            },
            "rejectMaintenanceEvent": {
                "description": "Reject a maintenance event with reason (Layer 2)",
                "handler": "MaintenanceMutationHandler::rejectMaintenanceEvent",
                "type": "status",
                "table": "vm_maintenance_events",
                "idColumn": "id",
                "statusField": "workflow_status",
                "targetStatus": "rejected",
                "validFromStatuses": [
                    "submitted",
                    "in_review",
                    "resubmitted"
                ],
                "additionalFields": [
                    "review_notes"
                ],
                "timestamps": {
                    "reviewed_at": true,
                    "reviewed_by": "user.id"
                },
                "audit": true,
                "confirm": true
            },
            "returnMaintenanceEvent": {
                "description": "Return maintenance event for correction with reason (Layer 2)",
                "handler": "MaintenanceMutationHandler::returnMaintenanceEvent",
                "type": "status",
                "table": "vm_maintenance_events",
                "idColumn": "id",
                "statusField": "workflow_status",
                "targetStatus": "needs_correction",
                "validFromStatuses": [
                    "submitted",
                    "in_review",
                    "resubmitted"
                ],
                "additionalFields": [
                    "correction_reason"
                ],
                "timestamps": {
                    "reviewed_at": true,
                    "reviewed_by": "user.id"
                },
                "audit": true
            },
            "updateSettings": {
                "description": "Update fleet package settings",
                "handler": "SettingsMutationHandler::updateSettings",
                "type": "update",
                "table": "vm_settings",
                "idColumn": "id",
                "fields": [
                    "track_odometer",
                    "track_fuel_type",
                    "track_fuel_cost",
                    "track_price_per_gallon",
                    "track_vendor",
                    "track_receipts",
                    "track_purchase_flag",
                    "track_maintenance_cost",
                    "track_parts_labor_split",
                    "track_invoices",
                    "track_photos",
                    "track_vin",
                    "track_license_plate",
                    "track_vehicle_color",
                    "track_assigned_driver",
                    "enable_departments",
                    "enable_campuses",
                    "require_approval",
                    "allow_driver_logging",
                    "enable_maintenance_tracking",
                    "enable_scheduling",
                    "maintenance_lead_time_days",
                    "maintenance_lead_distance_miles",
                    "share_vehicles"
                ],
                "timestamps": {
                    "updated_at": true,
                    "updated_by": "user.id"
                },
                "audit": true
            }
        }
    },
    "policy": {
        "roles": {
            "user": {
                "label": "Fleet User",
                "description": "View fleet, submit fuel and maintenance logs, view own records",
                "queries": [
                    "getFleetStats",
                    "listVehicles",
                    "getVehicle",
                    "getVehicleOptions",
                    "getDepartments",
                    "getCampuses",
                    "getTripCategories",
                    "getMaintenanceItems",
                    "getFuelStats",
                    "listFuelLogs",
                    "getFuelLog",
                    "getMaintenanceStats",
                    "listMaintenanceEvents"
                ],
                "mutations": [
                    "createFuelLog",
                    "createMaintenanceEvent"
                ]
            },
            "manager": {
                "label": "Fleet Manager",
                "description": "Review/correct/approve submissions, manage fleet and schedules",
                "inherits": "user",
                "queries": [
                    "listSchedules",
                    "getTemplates"
                ],
                "mutations": [
                    "createVehicle",
                    "updateVehicle",
                    "toggleOOS",
                    "approveFuelLog",
                    "rejectFuelLog",
                    "returnFuelLog",
                    "approveMaintenanceEvent",
                    "rejectMaintenanceEvent",
                    "returnMaintenanceEvent"
                ]
            },
            "admin": {
                "label": "Fleet Administrator",
                "description": "Full configuration — categories, templates, org, settings",
                "inherits": "manager",
                "queries": [
                    "listTripCategories",
                    "listTemplates",
                    "getSettings"
                ],
                "mutations": [
                    "updateSettings"
                ]
            }
        },
        "defaultRole": "user",
        "globalRoleMapping": {
            "super_admin": "admin",
            "admin": "manager",
            "principal": "manager",
            "business_manager": "manager",
            "maintenance_director": "manager",
            "substitute_manager": "user",
            "counselor": "user",
            "maintenance_staff": "user",
            "custodial_manager": "user",
            "custodial": "user",
            "cafeteria": "user",
            "student": "user",
            "staff": "user"
        }
    },
    "access": {
        "layer2": {
            "workflow": {
                "states": [
                    "draft",
                    "submitted",
                    "in_review",
                    "needs_correction",
                    "resubmitted",
                    "approved",
                    "rejected"
                ],
                "transitions": [
                    {
                        "from": "submitted",
                        "to": "in_review",
                        "actor": [
                            "manager",
                            "admin"
                        ]
                    },
                    {
                        "from": "in_review",
                        "to": "needs_correction",
                        "actor": [
                            "manager",
                            "admin"
                        ]
                    },
                    {
                        "from": "in_review",
                        "to": "approved",
                        "actor": [
                            "manager",
                            "admin"
                        ]
                    },
                    {
                        "from": "in_review",
                        "to": "rejected",
                        "actor": [
                            "manager",
                            "admin"
                        ]
                    },
                    {
                        "from": "needs_correction",
                        "to": "resubmitted",
                        "actor": [
                            "user",
                            "manager",
                            "admin"
                        ]
                    },
                    {
                        "from": "resubmitted",
                        "to": "in_review",
                        "actor": [
                            "manager",
                            "admin"
                        ]
                    },
                    {
                        "from": "resubmitted",
                        "to": "approved",
                        "actor": [
                            "manager",
                            "admin"
                        ]
                    },
                    {
                        "from": "resubmitted",
                        "to": "rejected",
                        "actor": [
                            "manager",
                            "admin"
                        ]
                    }
                ]
            },
            "editBoundaries": {
                "fuel_logs": {
                    "immutable": [
                        "id",
                        "created_at",
                        "logged_by",
                        "vehicle_id",
                        "event_date"
                    ],
                    "managerEdits": {
                        "editable": [
                            "gallons",
                            "odometer",
                            "total_cost",
                            "trip_category_id"
                        ],
                        "allowedStates": [
                            "submitted",
                            "in_review"
                        ],
                        "requiresReason": true
                    },
                    "userEdits": {
                        "editable": [
                            "gallons",
                            "odometer",
                            "total_cost",
                            "trip_category_id",
                            "vendor",
                            "location",
                            "notes"
                        ],
                        "allowedStates": [
                            "draft",
                            "needs_correction"
                        ],
                        "requiresReason": false
                    }
                },
                "maintenance_events": {
                    "immutable": [
                        "id",
                        "created_at",
                        "logged_by",
                        "vehicle_id",
                        "event_date"
                    ],
                    "managerEdits": {
                        "editable": [
                            "odometer",
                            "total_cost",
                            "parts_cost",
                            "labor_cost",
                            "notes"
                        ],
                        "allowedStates": [
                            "submitted",
                            "in_review"
                        ],
                        "requiresReason": true
                    },
                    "userEdits": {
                        "editable": [
                            "odometer",
                            "total_cost",
                            "parts_cost",
                            "labor_cost",
                            "vendor",
                            "notes"
                        ],
                        "allowedStates": [
                            "draft",
                            "needs_correction"
                        ],
                        "requiresReason": false
                    }
                }
            },
            "auditEvents": [
                "FUEL_LOG_SUBMITTED",
                "FUEL_LOG_REVIEW_STARTED",
                "FUEL_LOG_NEEDS_CORRECTION",
                "FUEL_LOG_RESUBMITTED",
                "FUEL_LOG_APPROVED",
                "FUEL_LOG_REJECTED",
                "MAINTENANCE_EVENT_SUBMITTED",
                "MAINTENANCE_EVENT_REVIEW_STARTED",
                "MAINTENANCE_EVENT_NEEDS_CORRECTION",
                "MAINTENANCE_EVENT_RESUBMITTED",
                "MAINTENANCE_EVENT_APPROVED",
                "MAINTENANCE_EVENT_REJECTED",
                "VEHICLE_CREATED",
                "VEHICLE_UPDATED",
                "VEHICLE_OOS_TOGGLED"
            ]
        }
    }
}
