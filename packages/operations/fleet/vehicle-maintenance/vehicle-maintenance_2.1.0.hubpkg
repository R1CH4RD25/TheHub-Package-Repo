{
    "schemaVersion": "3.0.0",
    "package": {
        "id": "operations.vehicle-maintenance",
        "display_name": "Vehicle Maintenance & Fleet Tracking",
        "description": "District-wide fleet inventory, fuel/trip tracking, and maintenance scheduling with Layer 2 manager oversight workflows",
        "version": "2.1.0",
        "author": "Woodson ISD Technology",
        "icon": "lucide-truck",
        "category": "operations",
        "base_url": "/p/operations.vehicle-maintenance",
        "tags": [
            "fleet",
            "vehicles",
            "maintenance",
            "fuel",
            "operations"
        ]
    },
    "database": {
        "connection": "woodson_hub",
        "primaryTable": "vm_vehicles",
        "auditTable": "vm_audit_logs"
    },
    "policies": {
        "scope": {
            "departmentScoped": true,
            "departmentColumn": "department_id",
            "ownerColumn": "created_by"
        },
        "fieldAccess": {
            "vin": { "minRole": "editor", "action": "redact" },
            "license_plate": { "minRole": "editor", "action": "redact" },
            "assigned_driver_name": { "minRole": "viewer", "action": "redact" },
            "insurance_policy": { "minRole": "admin", "action": "remove" },
            "purchase_price": { "minRole": "editor", "action": "redact" }
        },
        "queryAudit": ["getVehicle", "getSettings"]
    },
    "resources": {
        "provides": [
            {
                "key": "operations.vehicles",
                "contract": "1.0.0",
                "table": "vm_vehicles",
                "view": "hub_vehicles_v1",
                "description": "District vehicle inventory — consumers query the platform view, not the raw table",
                "settingsGate": "share_vehicles"
            }
        ],
        "requires": []
    },
    "presentation": {
        "pages": {
            "index": {
                "title": "Fleet Overview",
                "route": "/",
                "layout": "full",
                "components": [
                    {
                        "type": "dashboard",
                        "config": {
                            "columns": 4,
                            "cards": [
                                {
                                    "title": "Total Vehicles",
                                    "dataKey": "total_vehicles",
                                    "icon": "lucide-truck",
                                    "color": "primary"
                                },
                                {
                                    "title": "In Service",
                                    "dataKey": "in_service",
                                    "icon": "lucide-circle-check",
                                    "color": "success"
                                },
                                {
                                    "title": "Out of Service",
                                    "dataKey": "out_of_service",
                                    "icon": "lucide-circle-x",
                                    "color": "danger"
                                },
                                {
                                    "title": "Maintenance Due",
                                    "dataKey": "maintenance_due",
                                    "icon": "lucide-wrench",
                                    "color": "warning"
                                }
                            ]
                        },
                        "dataQuery": "getFleetStats"
                    },
                    {
                        "type": "filters",
                        "config": {
                            "targetTable": "pkg-table-vehicles",
                            "filters": [
                                {
                                    "name": "search",
                                    "type": "search",
                                    "placeholder": "Search by unit, VIN, or make/model...",
                                    "debounce": 300
                                },
                                {
                                    "name": "status",
                                    "type": "select",
                                    "label": "Status",
                                    "options": [
                                        {
                                            "value": "active",
                                            "label": "In Service"
                                        },
                                        {
                                            "value": "oos",
                                            "label": "Out of Service"
                                        }
                                    ]
                                },
                                {
                                    "name": "department",
                                    "type": "select",
                                    "label": "Department",
                                    "optionsQuery": "getDepartments"
                                }
                            ]
                        }
                    },
                    {
                        "type": "table",
                        "config": {
                            "id": "pkg-table-vehicles",
                            "columns": [
                                {
                                    "key": "unit_number",
                                    "label": "Unit #",
                                    "sortable": true,
                                    "width": "10%"
                                },
                                {
                                    "key": "display_name",
                                    "label": "Vehicle",
                                    "sortable": true,
                                    "primary": true,
                                    "width": "22%"
                                },
                                {
                                    "key": "vin",
                                    "label": "VIN",
                                    "responsive": "hide-mobile",
                                    "width": "15%"
                                },
                                {
                                    "key": "license_plate",
                                    "label": "Plate",
                                    "responsive": "hide-tablet",
                                    "width": "10%"
                                },
                                {
                                    "key": "current_odometer",
                                    "label": "Odometer",
                                    "sortable": true,
                                    "width": "10%",
                                    "responsive": "hide-mobile"
                                },
                                {
                                    "key": "status_badge",
                                    "label": "Status",
                                    "style": "badge",
                                    "width": "10%"
                                },
                                {
                                    "key": "department_name",
                                    "label": "Dept",
                                    "style": "badge",
                                    "responsive": "hide-mobile",
                                    "width": "12%"
                                }
                            ],
                            "actions": [
                                {
                                    "label": "View",
                                    "icon": "lucide-eye",
                                    "type": "route",
                                    "route": "/vehicle/{id}",
                                    "variant": "warning"
                                }
                            ],
                            "defaultSort": {
                                "column": "unit_number",
                                "direction": "asc"
                            },
                            "pagination": {
                                "perPage": 25,
                                "pageSizes": [
                                    10,
                                    25,
                                    50
                                ]
                            },
                            "emptyState": {
                                "icon": "lucide-truck",
                                "title": "No Vehicles Found",
                                "description": "No vehicles match your search criteria."
                            }
                        },
                        "dataQuery": "listVehicles"
                    }
                ]
            },
            "vehicle": {
                "title": "Vehicle Details",
                "route": "/vehicle/{id}",
                "layout": "standard",
                "components": [
                    {
                        "type": "detail",
                        "config": {
                            "backRoute": "/",
                            "actions": [
                                {
                                    "label": "Edit",
                                    "icon": "lucide-pencil",
                                    "type": "route",
                                    "route": "/vehicle/{id}/edit",
                                    "style": "primary"
                                },
                                {
                                    "label": "Log Fuel",
                                    "icon": "lucide-fuel",
                                    "type": "route",
                                    "route": "/fuel/add?vehicle_id={id}",
                                    "style": "success"
                                },
                                {
                                    "label": "Log Maintenance",
                                    "icon": "lucide-wrench",
                                    "type": "route",
                                    "route": "/maintenance/add?vehicle_id={id}",
                                    "style": "info"
                                }
                            ],
                            "sections": [
                                {
                                    "title": "Vehicle Information",
                                    "icon": "lucide-truck",
                                    "columns": 2,
                                    "fields": [
                                        {
                                            "key": "unit_number",
                                            "label": "Unit Number",
                                            "copyable": true
                                        },
                                        {
                                            "key": "display_name",
                                            "label": "Year / Make / Model"
                                        },
                                        {
                                            "key": "color",
                                            "label": "Color",
                                            "showIf": {
                                                "settingsKey": "track_vehicle_color"
                                            }
                                        },
                                        {
                                            "key": "vin",
                                            "label": "VIN",
                                            "copyable": true,
                                            "showIf": {
                                                "settingsKey": "track_vin"
                                            }
                                        },
                                        {
                                            "key": "license_plate",
                                            "label": "License Plate",
                                            "showIf": {
                                                "settingsKey": "track_license_plate"
                                            }
                                        },
                                        {
                                            "key": "current_odometer",
                                            "label": "Current Odometer",
                                            "showIf": {
                                                "settingsKey": "track_odometer"
                                            }
                                        },
                                        {
                                            "key": "assigned_driver_name",
                                            "label": "Assigned Driver",
                                            "showIf": {
                                                "settingsKey": "track_assigned_driver"
                                            }
                                        },
                                        {
                                            "key": "is_shared",
                                            "label": "Shared Vehicle",
                                            "type": "badge",
                                            "showIf": {
                                                "settingsKey": "share_vehicles"
                                            }
                                        },
                                        {
                                            "key": "status_badge",
                                            "label": "Status",
                                            "type": "badge"
                                        },
                                        {
                                            "key": "oos_reason",
                                            "label": "OOS Reason"
                                        },
                                        {
                                            "key": "department_name",
                                            "label": "Department",
                                            "type": "badge",
                                            "showIf": {
                                                "settingsKey": "enable_departments"
                                            }
                                        },
                                        {
                                            "key": "campus_name",
                                            "label": "Campus",
                                            "type": "badge",
                                            "showIf": {
                                                "settingsKey": "enable_campuses"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "title": "Maintenance Schedule",
                                    "icon": "lucide-calendar-clock",
                                    "collapsible": true,
                                    "fields": [
                                        {
                                            "key": "template_name",
                                            "label": "Maintenance Template"
                                        },
                                        {
                                            "key": "next_service_due",
                                            "label": "Next Service Due",
                                            "type": "date"
                                        },
                                        {
                                            "key": "next_service_miles",
                                            "label": "Next Service Miles"
                                        }
                                    ]
                                }
                            ]
                        },
                        "dataQuery": "getVehicle"
                    }
                ]
            },
            "vehicle-add": {
                "title": "Add Vehicle",
                "route": "/vehicle/add",
                "layout": "standard",
                "access": [
                    "manager",
                    "admin"
                ],
                "components": [
                    {
                        "type": "form",
                        "config": {
                            "mutation": "createVehicle",
                            "submitLabel": "Add Vehicle",
                            "cancelRoute": "/",
                            "sections": [
                                {
                                    "title": "Vehicle Information",
                                    "grid": 2,
                                    "fields": [
                                        {
                                            "key": "unit_number",
                                            "type": "text",
                                            "label": "Unit Number",
                                            "required": true,
                                            "placeholder": "e.g. BUS-01",
                                            "helpText": "Unique fleet identifier"
                                        },
                                        {
                                            "key": "name",
                                            "type": "text",
                                            "label": "Vehicle Name",
                                            "placeholder": "e.g. Activity Bus 1",
                                            "helpText": "Friendly name (optional)"
                                        },
                                        {
                                            "key": "year",
                                            "type": "number",
                                            "label": "Year",
                                            "required": true,
                                            "placeholder": "e.g. 2022",
                                            "step": 1,
                                            "validation": {
                                                "min": 1990,
                                                "max": 2030
                                            }
                                        },
                                        {
                                            "key": "make",
                                            "type": "text",
                                            "label": "Make",
                                            "required": true,
                                            "placeholder": "e.g. Blue Bird"
                                        },
                                        {
                                            "key": "model",
                                            "type": "text",
                                            "label": "Model",
                                            "required": true,
                                            "placeholder": "e.g. Vision"
                                        },
                                        {
                                            "key": "vin",
                                            "type": "text",
                                            "label": "VIN",
                                            "placeholder": "17-character VIN",
                                            "validation": {
                                                "maxLength": 17,
                                                "pattern": "^[A-HJ-NPR-Z0-9]{17}$"
                                            },
                                            "showIf": {
                                                "settingsKey": "track_vin"
                                            }
                                        },
                                        {
                                            "key": "license_plate",
                                            "type": "text",
                                            "label": "License Plate",
                                            "placeholder": "e.g. TX 1234567",
                                            "showIf": {
                                                "settingsKey": "track_license_plate"
                                            }
                                        },
                                        {
                                            "key": "color",
                                            "type": "text",
                                            "label": "Color",
                                            "placeholder": "e.g. Yellow, White",
                                            "showIf": {
                                                "settingsKey": "track_vehicle_color"
                                            }
                                        },
                                        {
                                            "key": "current_odometer",
                                            "type": "number",
                                            "label": "Current Odometer",
                                            "step": 1,
                                            "placeholder": "Current mileage",
                                            "validation": {
                                                "min": 0,
                                                "max": 999999
                                            },
                                            "showIf": {
                                                "settingsKey": "track_odometer"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "title": "Assignment & Sharing",
                                    "grid": 2,
                                    "fields": [
                                        {
                                            "key": "assigned_driver_id",
                                            "type": "select",
                                            "label": "Assigned Driver",
                                            "optionsQuery": "getUserOptions",
                                            "helpText": "Primary driver for this vehicle",
                                            "showIf": {
                                                "settingsKey": "track_assigned_driver"
                                            }
                                        },
                                        {
                                            "key": "department_id",
                                            "type": "select",
                                            "label": "Department",
                                            "optionsQuery": "getDepartments",
                                            "helpText": "Optional — assign to a department",
                                            "showIf": {
                                                "settingsKey": "enable_departments"
                                            }
                                        },
                                        {
                                            "key": "campus_id",
                                            "type": "select",
                                            "label": "Campus",
                                            "optionsQuery": "getCampuses",
                                            "helpText": "Optional — assign to a campus",
                                            "showIf": {
                                                "settingsKey": "enable_campuses"
                                            }
                                        },
                                        {
                                            "key": "is_shared",
                                            "type": "checkbox",
                                            "label": "Available to Other Packages",
                                            "helpText": "Allow other packages to reference this vehicle",
                                            "showIf": {
                                                "settingsKey": "share_vehicles"
                                            }
                                        },
                                        {
                                            "key": "template_id",
                                            "type": "select",
                                            "label": "Maintenance Template",
                                            "optionsQuery": "getTemplates",
                                            "helpText": "Apply a maintenance schedule template"
                                        }
                                    ]
                                }
                            ]
                        }
                    }
                ]
            },
            "fuel-log": {
                "title": "Submit Fuel Log",
                "route": "/fuel/add",
                "layout": "standard",
                "access": [
                    "user",
                    "manager",
                    "admin"
                ],
                "components": [
                    {
                        "type": "form",
                        "config": {
                            "mutation": "createFuelLog",
                            "submitLabel": "Submit Fuel Log",
                            "cancelRoute": "/fuel",
                            "sections": [
                                {
                                    "title": "Trip Information",
                                    "grid": 2,
                                    "fields": [
                                        {
                                            "key": "vehicle_id",
                                            "type": "select",
                                            "label": "Vehicle",
                                            "required": true,
                                            "optionsQuery": "getVehicleOptions"
                                        },
                                        {
                                            "key": "event_date",
                                            "type": "date",
                                            "label": "Date",
                                            "required": true
                                        },
                                        {
                                            "key": "trip_category_id",
                                            "type": "select",
                                            "label": "Trip Purpose",
                                            "required": true,
                                            "optionsQuery": "getTripCategories",
                                            "helpText": "Select the purpose of this trip"
                                        },
                                        {
                                            "key": "odometer",
                                            "type": "number",
                                            "label": "Odometer Reading",
                                            "step": 1,
                                            "placeholder": "Current mileage",
                                            "validation": {
                                                "min": 0,
                                                "max": 999999
                                            },
                                            "showIf": {
                                                "settingsKey": "track_odometer"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "title": "Fuel Details",
                                    "grid": 2,
                                    "fields": [
                                        {
                                            "key": "gallons",
                                            "type": "number",
                                            "label": "Gallons",
                                            "required": true,
                                            "placeholder": "e.g. 45.5",
                                            "validation": {
                                                "min": 0.01,
                                                "max": 9999.99
                                            }
                                        },
                                        {
                                            "key": "fuel_type",
                                            "type": "select",
                                            "label": "Fuel Type",
                                            "options": [
                                                {
                                                    "value": "unleaded",
                                                    "label": "Unleaded"
                                                },
                                                {
                                                    "value": "diesel",
                                                    "label": "Diesel"
                                                },
                                                {
                                                    "value": "propane",
                                                    "label": "Propane"
                                                },
                                                {
                                                    "value": "other",
                                                    "label": "Other"
                                                }
                                            ],
                                            "showIf": {
                                                "settingsKey": "track_fuel_type"
                                            }
                                        },
                                        {
                                            "key": "total_cost",
                                            "type": "currency",
                                            "label": "Total Cost",
                                            "showIf": {
                                                "settingsKey": "track_fuel_cost"
                                            }
                                        },
                                        {
                                            "key": "price_per_gallon",
                                            "type": "currency",
                                            "label": "Price per Gallon",
                                            "showIf": {
                                                "settingsKey": "track_price_per_gallon"
                                            }
                                        },
                                        {
                                            "key": "is_purchase",
                                            "type": "checkbox",
                                            "label": "Purchased Fuel (not district tank)",
                                            "helpText": "Check if fuel was purchased from an external vendor",
                                            "showIf": {
                                                "settingsKey": "track_purchase_flag"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "title": "Vendor & Receipt",
                                    "description": "Purchase details for externally-sourced fuel",
                                    "collapsible": true,
                                    "collapsed": true,
                                    "grid": 2,
                                    "showIf": {
                                        "settingsKey": "track_vendor"
                                    },
                                    "fields": [
                                        {
                                            "key": "vendor",
                                            "type": "text",
                                            "label": "Vendor",
                                            "placeholder": "e.g. Shell, Buc-ee's"
                                        },
                                        {
                                            "key": "location",
                                            "type": "text",
                                            "label": "Location",
                                            "placeholder": "City or address"
                                        },
                                        {
                                            "key": "receipt_path",
                                            "type": "file",
                                            "label": "Receipt Upload",
                                            "accept": ".pdf,.jpg,.jpeg,.png",
                                            "fullWidth": true,
                                            "helpText": "PDF, JPG, or PNG — max 5 MB",
                                            "showIf": {
                                                "settingsKey": "track_receipts"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "title": "Notes",
                                    "fields": [
                                        {
                                            "key": "notes",
                                            "type": "textarea",
                                            "label": "Notes",
                                            "rows": 3,
                                            "placeholder": "Additional details about this trip..."
                                        }
                                    ]
                                }
                            ]
                        }
                    }
                ]
            },
            "fuel": {
                "title": "Fuel Logs",
                "route": "/fuel",
                "layout": "full",
                "components": [
                    {
                        "type": "dashboard",
                        "config": {
                            "columns": 4,
                            "cards": [
                                {
                                    "title": "Logs This Month",
                                    "dataKey": "logs_this_month",
                                    "icon": "lucide-fuel",
                                    "color": "primary"
                                },
                                {
                                    "title": "Total Gallons",
                                    "dataKey": "total_gallons",
                                    "icon": "lucide-droplets",
                                    "color": "info"
                                },
                                {
                                    "title": "Total Cost",
                                    "dataKey": "total_cost",
                                    "icon": "lucide-dollar-sign",
                                    "color": "success",
                                    "format": "currency",
                                    "showIf": {
                                        "settingsKey": "track_fuel_cost"
                                    }
                                },
                                {
                                    "title": "Pending Review",
                                    "dataKey": "pending_review",
                                    "icon": "lucide-clock",
                                    "color": "warning",
                                    "showIf": {
                                        "settingsKey": "require_approval"
                                    }
                                }
                            ]
                        },
                        "dataQuery": "getFuelStats"
                    },
                    {
                        "type": "filters",
                        "config": {
                            "targetTable": "pkg-table-fuel",
                            "filters": [
                                {
                                    "name": "search",
                                    "type": "search",
                                    "placeholder": "Search by vehicle, driver...",
                                    "debounce": 300
                                },
                                {
                                    "name": "trip_category",
                                    "type": "select",
                                    "label": "Trip Code",
                                    "optionsQuery": "getTripCategories"
                                },
                                {
                                    "name": "vehicle_id",
                                    "type": "select",
                                    "label": "Vehicle",
                                    "optionsQuery": "getVehicleOptions"
                                },
                                {
                                    "name": "status",
                                    "type": "select",
                                    "label": "Status",
                                    "options": [
                                        {
                                            "value": "draft",
                                            "label": "Draft"
                                        },
                                        {
                                            "value": "submitted",
                                            "label": "Submitted"
                                        },
                                        {
                                            "value": "in_review",
                                            "label": "In Review"
                                        },
                                        {
                                            "value": "needs_correction",
                                            "label": "Needs Correction"
                                        },
                                        {
                                            "value": "resubmitted",
                                            "label": "Resubmitted"
                                        },
                                        {
                                            "value": "approved",
                                            "label": "Approved"
                                        },
                                        {
                                            "value": "rejected",
                                            "label": "Rejected"
                                        }
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "type": "table",
                        "config": {
                            "id": "pkg-table-fuel",
                            "columns": [
                                {
                                    "key": "event_date",
                                    "label": "Date",
                                    "sortable": true,
                                    "style": "date",
                                    "width": "12%"
                                },
                                {
                                    "key": "unit_number",
                                    "label": "Vehicle",
                                    "sortable": true,
                                    "width": "14%"
                                },
                                {
                                    "key": "trip_code",
                                    "label": "Trip Purpose",
                                    "style": "badge",
                                    "width": "12%"
                                },
                                {
                                    "key": "gallons",
                                    "label": "Gallons",
                                    "sortable": true,
                                    "width": "10%"
                                },
                                {
                                    "key": "odometer",
                                    "label": "Odometer",
                                    "width": "10%",
                                    "responsive": "hide-mobile",
                                    "showIf": {
                                        "settingsKey": "track_odometer"
                                    }
                                },
                                {
                                    "key": "total_cost",
                                    "label": "Cost",
                                    "style": "currency",
                                    "width": "10%",
                                    "responsive": "hide-mobile",
                                    "showIf": {
                                        "settingsKey": "track_fuel_cost"
                                    }
                                },
                                {
                                    "key": "driver_name",
                                    "label": "Logged By",
                                    "responsive": "hide-mobile",
                                    "width": "15%"
                                },
                                {
                                    "key": "workflow_status",
                                    "label": "Status",
                                    "style": "badge",
                                    "width": "10%",
                                    "showIf": {
                                        "settingsKey": "require_approval"
                                    }
                                }
                            ],
                            "actions": [
                                {
                                    "label": "View",
                                    "icon": "lucide-eye",
                                    "type": "route",
                                    "route": "/fuel/{id}",
                                    "variant": "warning"
                                }
                            ],
                            "defaultSort": {
                                "column": "event_date",
                                "direction": "desc"
                            },
                            "pagination": {
                                "perPage": 25,
                                "pageSizes": [
                                    10,
                                    25,
                                    50
                                ]
                            },
                            "emptyState": {
                                "icon": "lucide-fuel",
                                "title": "No Fuel Logs",
                                "description": "No fuel logs match your search criteria."
                            }
                        },
                        "dataQuery": "listFuelLogs"
                    }
                ]
            },
            "fuel-detail": {
                "title": "Fuel Log Details",
                "route": "/fuel/{id}",
                "layout": "standard",
                "components": [
                    {
                        "type": "detail",
                        "config": {
                            "backRoute": "/fuel",
                            "actions": [
                                {
                                    "label": "Approve",
                                    "icon": "lucide-check",
                                    "type": "mutation",
                                    "mutation": "approveFuelLog",
                                    "style": "success",
                                    "confirm": "Approve this fuel log?"
                                },
                                {
                                    "label": "Reject",
                                    "icon": "lucide-x",
                                    "type": "mutation",
                                    "mutation": "rejectFuelLog",
                                    "style": "danger",
                                    "confirm": "Reject this fuel log? A reason is required."
                                }
                            ],
                            "sections": [
                                {
                                    "title": "Trip Information",
                                    "icon": "lucide-map-pin",
                                    "columns": 2,
                                    "fields": [
                                        {
                                            "key": "event_date",
                                            "label": "Date",
                                            "type": "date"
                                        },
                                        {
                                            "key": "unit_number",
                                            "label": "Vehicle"
                                        },
                                        {
                                            "key": "trip_code",
                                            "label": "Trip Purpose",
                                            "type": "badge"
                                        },
                                        {
                                            "key": "odometer",
                                            "label": "Odometer Reading",
                                            "showIf": {
                                                "settingsKey": "track_odometer"
                                            }
                                        },
                                        {
                                            "key": "driver_name",
                                            "label": "Logged By"
                                        },
                                        {
                                            "key": "workflow_status",
                                            "label": "Status",
                                            "type": "badge",
                                            "showIf": {
                                                "settingsKey": "require_approval"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "title": "Fuel Details",
                                    "icon": "lucide-fuel",
                                    "columns": 2,
                                    "fields": [
                                        {
                                            "key": "gallons",
                                            "label": "Gallons"
                                        },
                                        {
                                            "key": "fuel_type",
                                            "label": "Fuel Type",
                                            "type": "badge",
                                            "showIf": {
                                                "settingsKey": "track_fuel_type"
                                            }
                                        },
                                        {
                                            "key": "total_cost",
                                            "label": "Cost",
                                            "type": "currency",
                                            "showIf": {
                                                "settingsKey": "track_fuel_cost"
                                            }
                                        },
                                        {
                                            "key": "price_per_gallon",
                                            "label": "Price/Gallon",
                                            "type": "currency",
                                            "showIf": {
                                                "settingsKey": "track_price_per_gallon"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "title": "Vendor & Location",
                                    "icon": "lucide-store",
                                    "collapsible": true,
                                    "showIf": {
                                        "settingsKey": "track_vendor"
                                    },
                                    "fields": [
                                        {
                                            "key": "vendor",
                                            "label": "Vendor"
                                        },
                                        {
                                            "key": "location",
                                            "label": "Location"
                                        }
                                    ]
                                },
                                {
                                    "title": "Notes & Attachments",
                                    "icon": "lucide-paperclip",
                                    "collapsible": true,
                                    "fields": [
                                        {
                                            "key": "notes",
                                            "label": "Notes"
                                        },
                                        {
                                            "key": "receipt_path",
                                            "label": "Receipt",
                                            "type": "link",
                                            "showIf": {
                                                "settingsKey": "track_receipts"
                                            }
                                        }
                                    ]
                                }
                            ]
                        },
                        "dataQuery": "getFuelLog"
                    }
                ]
            },
            "maintenance-log": {
                "title": "Submit Maintenance Log",
                "route": "/maintenance/add",
                "layout": "standard",
                "access": [
                    "user",
                    "manager",
                    "admin"
                ],
                "components": [
                    {
                        "type": "form",
                        "config": {
                            "mutation": "createMaintenanceEvent",
                            "submitLabel": "Submit Maintenance Log",
                            "cancelRoute": "/maintenance",
                            "sections": [
                                {
                                    "title": "Service Information",
                                    "grid": 2,
                                    "fields": [
                                        {
                                            "key": "vehicle_id",
                                            "type": "select",
                                            "label": "Vehicle",
                                            "required": true,
                                            "optionsQuery": "getVehicleOptions"
                                        },
                                        {
                                            "key": "maintenance_item_id",
                                            "type": "select",
                                            "label": "Maintenance Type",
                                            "required": true,
                                            "optionsQuery": "getMaintenanceItems",
                                            "helpText": "e.g. Oil Change, Tire Rotation, Brake Inspection"
                                        },
                                        {
                                            "key": "maintenance_date",
                                            "type": "date",
                                            "label": "Service Date",
                                            "required": true
                                        },
                                        {
                                            "key": "odometer",
                                            "type": "number",
                                            "label": "Odometer at Service",
                                            "step": 1,
                                            "placeholder": "Current mileage",
                                            "validation": {
                                                "min": 0,
                                                "max": 999999
                                            },
                                            "showIf": {
                                                "settingsKey": "track_odometer"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "title": "Vendor & Costs",
                                    "grid": 2,
                                    "showIf": {
                                        "settingsKey": "track_maintenance_cost"
                                    },
                                    "fields": [
                                        {
                                            "key": "vendor",
                                            "type": "text",
                                            "label": "Vendor / Shop",
                                            "placeholder": "e.g. WISD Bus Barn, Pep Boys"
                                        },
                                        {
                                            "key": "total_cost",
                                            "type": "currency",
                                            "label": "Total Cost"
                                        },
                                        {
                                            "key": "parts_cost",
                                            "type": "currency",
                                            "label": "Parts Cost",
                                            "showIf": {
                                                "settingsKey": "track_parts_labor_split"
                                            }
                                        },
                                        {
                                            "key": "labor_cost",
                                            "type": "currency",
                                            "label": "Labor Cost",
                                            "showIf": {
                                                "settingsKey": "track_parts_labor_split"
                                            }
                                        }
                                    ]
                                },
                                {
                                    "title": "Documentation",
                                    "collapsible": true,
                                    "collapsed": true,
                                    "fields": [
                                        {
                                            "key": "notes",
                                            "type": "textarea",
                                            "label": "Service Notes",
                                            "rows": 3,
                                            "placeholder": "Describe work performed..."
                                        },
                                        {
                                            "key": "invoice",
                                            "type": "file",
                                            "label": "Invoice Upload",
                                            "accept": ".pdf,.jpg,.jpeg,.png",
                                            "helpText": "PDF, JPG, or PNG — max 5 MB",
                                            "showIf": {
                                                "settingsKey": "track_invoices"
                                            }
                                        },
                                        {
                                            "key": "photos",
                                            "type": "file",
                                            "label": "Service Photos",
                                            "accept": ".jpg,.jpeg,.png",
                                            "helpText": "JPG or PNG — max 10 MB",
                                            "showIf": {
                                                "settingsKey": "track_photos"
                                            }
                                        }
                                    ]
                                }
                            ]
                        }
                    }
                ]
            },
            "maintenance": {
                "title": "Maintenance Logs",
                "route": "/maintenance",
                "layout": "full",
                "components": [
                    {
                        "type": "dashboard",
                        "config": {
                            "columns": 4,
                            "cards": [
                                {
                                    "title": "Events This Month",
                                    "dataKey": "events_this_month",
                                    "icon": "lucide-wrench",
                                    "color": "primary"
                                },
                                {
                                    "title": "Total Parts Cost",
                                    "dataKey": "total_parts_cost",
                                    "icon": "lucide-package",
                                    "color": "info",
                                    "format": "currency",
                                    "showIf": {
                                        "settingsKey": "track_parts_labor_split"
                                    }
                                },
                                {
                                    "title": "Total Labor Cost",
                                    "dataKey": "total_labor_cost",
                                    "icon": "lucide-hard-hat",
                                    "color": "warning",
                                    "format": "currency",
                                    "showIf": {
                                        "settingsKey": "track_parts_labor_split"
                                    }
                                },
                                {
                                    "title": "Pending Review",
                                    "dataKey": "pending_review",
                                    "icon": "lucide-clock",
                                    "color": "danger"
                                }
                            ]
                        },
                        "dataQuery": "getMaintenanceStats"
                    },
                    {
                        "type": "filters",
                        "config": {
                            "targetTable": "pkg-table-maintenance",
                            "filters": [
                                {
                                    "name": "search",
                                    "type": "search",
                                    "placeholder": "Search by vehicle, type, vendor...",
                                    "debounce": 300
                                },
                                {
                                    "name": "vehicle_id",
                                    "type": "select",
                                    "label": "Vehicle",
                                    "optionsQuery": "getVehicleOptions"
                                },
                                {
                                    "name": "maintenance_item_id",
                                    "type": "select",
                                    "label": "Type",
                                    "optionsQuery": "getMaintenanceItems"
                                },
                                {
                                    "name": "status",
                                    "type": "select",
                                    "label": "Status",
                                    "options": [
                                        {
                                            "value": "submitted",
                                            "label": "Submitted"
                                        },
                                        {
                                            "value": "in_review",
                                            "label": "In Review"
                                        },
                                        {
                                            "value": "approved",
                                            "label": "Approved"
                                        },
                                        {
                                            "value": "rejected",
                                            "label": "Rejected"
                                        }
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "type": "table",
                        "config": {
                            "id": "pkg-table-maintenance",
                            "columns": [
                                {
                                    "key": "maintenance_date",
                                    "label": "Date",
                                    "sortable": true,
                                    "style": "date",
                                    "width": "12%"
                                },
                                {
                                    "key": "unit_number",
                                    "label": "Vehicle",
                                    "sortable": true,
                                    "width": "12%"
                                },
                                {
                                    "key": "maintenance_type",
                                    "label": "Service",
                                    "width": "18%"
                                },
                                {
                                    "key": "vendor",
                                    "label": "Vendor",
                                    "responsive": "hide-mobile",
                                    "width": "15%"
                                },
                                {
                                    "key": "total_cost",
                                    "label": "Cost",
                                    "style": "currency",
                                    "sortable": true,
                                    "width": "10%",
                                    "showIf": {
                                        "settingsKey": "track_maintenance_cost"
                                    }
                                },
                                {
                                    "key": "odometer",
                                    "label": "Odometer",
                                    "responsive": "hide-mobile",
                                    "width": "10%",
                                    "showIf": {
                                        "settingsKey": "track_odometer"
                                    }
                                },
                                {
                                    "key": "workflow_status",
                                    "label": "Status",
                                    "style": "badge",
                                    "width": "10%",
                                    "showIf": {
                                        "settingsKey": "require_approval"
                                    }
                                }
                            ],
                            "actions": [
                                {
                                    "label": "View",
                                    "icon": "lucide-eye",
                                    "type": "route",
                                    "route": "/maintenance/{id}",
                                    "variant": "warning"
                                }
                            ],
                            "defaultSort": {
                                "column": "maintenance_date",
                                "direction": "desc"
                            },
                            "pagination": {
                                "perPage": 25,
                                "pageSizes": [
                                    10,
                                    25,
                                    50
                                ]
                            },
                            "emptyState": {
                                "icon": "lucide-wrench",
                                "title": "No Maintenance Records",
                                "description": "No maintenance logs match your criteria."
                            }
                        },
                        "dataQuery": "listMaintenanceEvents"
                    }
                ]
            },
            "schedules": {
                "title": "Maintenance Schedules",
                "route": "/schedules",
                "layout": "full",
                "access": [
                    "manager",
                    "admin"
                ],
                "components": [
                    {
                        "type": "filters",
                        "config": {
                            "targetTable": "pkg-table-schedules",
                            "filters": [
                                {
                                    "name": "search",
                                    "type": "search",
                                    "placeholder": "Search vehicles...",
                                    "debounce": 300
                                },
                                {
                                    "name": "due_status",
                                    "type": "select",
                                    "label": "Due Status",
                                    "options": [
                                        {
                                            "value": "overdue",
                                            "label": "Overdue"
                                        },
                                        {
                                            "value": "due_soon",
                                            "label": "Due Soon"
                                        },
                                        {
                                            "value": "ok",
                                            "label": "Up to Date"
                                        }
                                    ]
                                }
                            ]
                        }
                    },
                    {
                        "type": "table",
                        "config": {
                            "id": "pkg-table-schedules",
                            "columns": [
                                {
                                    "key": "unit_number",
                                    "label": "Vehicle",
                                    "sortable": true,
                                    "width": "12%"
                                },
                                {
                                    "key": "maintenance_type",
                                    "label": "Service Item",
                                    "width": "20%"
                                },
                                {
                                    "key": "last_service_date",
                                    "label": "Last Service",
                                    "style": "date",
                                    "width": "12%"
                                },
                                {
                                    "key": "next_due_date",
                                    "label": "Next Due",
                                    "style": "date",
                                    "sortable": true,
                                    "width": "12%"
                                },
                                {
                                    "key": "next_due_miles",
                                    "label": "Due at Miles",
                                    "width": "12%",
                                    "responsive": "hide-mobile"
                                },
                                {
                                    "key": "due_status",
                                    "label": "Status",
                                    "style": "badge",
                                    "width": "10%"
                                }
                            ],
                            "defaultSort": {
                                "column": "next_due_date",
                                "direction": "asc"
                            },
                            "pagination": {
                                "perPage": 100
                            },
                            "emptyState": {
                                "icon": "lucide-calendar-clock",
                                "title": "No Schedules",
                                "description": "No maintenance schedules configured. Apply templates to vehicles first."
                            }
                        },
                        "dataQuery": "listSchedules"
                    }
                ]
            },
            "trip-categories": {
                "title": "Trip Categories",
                "route": "/config/trip-categories",
                "layout": "standard",
                "access": [
                    "admin"
                ],
                "components": [
                    {
                        "type": "table",
                        "config": {
                            "id": "pkg-table-trips",
                            "columns": [
                                {
                                    "key": "code",
                                    "label": "Code",
                                    "sortable": true,
                                    "width": "10%"
                                },
                                {
                                    "key": "name",
                                    "label": "Name",
                                    "sortable": true,
                                    "width": "30%"
                                },
                                {
                                    "key": "description",
                                    "label": "Description",
                                    "width": "35%"
                                },
                                {
                                    "key": "is_active",
                                    "label": "Active",
                                    "style": "boolean",
                                    "width": "10%"
                                }
                            ],
                            "actions": [
                                {
                                    "label": "Edit",
                                    "icon": "lucide-pencil",
                                    "type": "route",
                                    "route": "/config/trip-categories/{id}/edit",
                                    "variant": "primary"
                                }
                            ],
                            "emptyState": {
                                "icon": "lucide-route",
                                "title": "No Trip Categories",
                                "description": "Trip categories will be seeded on first install."
                            }
                        },
                        "dataQuery": "listTripCategories"
                    }
                ]
            },
            "templates": {
                "title": "Maintenance Templates",
                "route": "/config/templates",
                "layout": "standard",
                "access": [
                    "admin"
                ],
                "components": [
                    {
                        "type": "table",
                        "config": {
                            "id": "pkg-table-templates",
                            "columns": [
                                {
                                    "key": "name",
                                    "label": "Template Name",
                                    "sortable": true,
                                    "width": "25%"
                                },
                                {
                                    "key": "description",
                                    "label": "Description",
                                    "width": "35%"
                                },
                                {
                                    "key": "item_count",
                                    "label": "Items",
                                    "width": "10%"
                                },
                                {
                                    "key": "vehicle_count",
                                    "label": "Vehicles Using",
                                    "width": "15%"
                                },
                                {
                                    "key": "is_active",
                                    "label": "Active",
                                    "style": "boolean",
                                    "width": "10%"
                                }
                            ],
                            "actions": [
                                {
                                    "label": "View",
                                    "icon": "lucide-eye",
                                    "type": "route",
                                    "route": "/config/templates/{id}",
                                    "variant": "warning"
                                }
                            ],
                            "emptyState": {
                                "icon": "lucide-clipboard-list",
                                "title": "No Templates",
                                "description": "Create maintenance templates to auto-generate schedules when applied to vehicles."
                            }
                        },
                        "dataQuery": "listTemplates"
                    }
                ]
            },
            "settings": {
                "title": "Fleet Settings",
                "route": "/config/settings",
                "layout": "standard",
                "access": [
                    "admin"
                ],
                "components": [
                    {
                        "type": "form",
                        "config": {
                            "mutation": "updateSettings",
                            "submitLabel": "Save Settings",
                            "loadQuery": "getSettings",
                            "sections": [
                                {
                                    "title": "Fuel Logging — Optional Fields",
                                    "description": "Core fields (vehicle, date, gallons, trip purpose) are always visible. Toggle additional fields below.",
                                    "icon": "lucide-fuel",
                                    "grid": 2,
                                    "fields": [
                                        {
                                            "key": "track_odometer",
                                            "type": "checkbox",
                                            "label": "Track Odometer Reading",
                                            "helpText": "Record mileage on each fuel log"
                                        },
                                        {
                                            "key": "track_fuel_type",
                                            "type": "checkbox",
                                            "label": "Track Fuel Type",
                                            "helpText": "Unleaded, diesel, propane, etc."
                                        },
                                        {
                                            "key": "track_fuel_cost",
                                            "type": "checkbox",
                                            "label": "Track Fuel Cost",
                                            "helpText": "Total cost per fill-up"
                                        },
                                        {
                                            "key": "track_price_per_gallon",
                                            "type": "checkbox",
                                            "label": "Track Price per Gallon",
                                            "helpText": "Unit cost tracking"
                                        },
                                        {
                                            "key": "track_purchase_flag",
                                            "type": "checkbox",
                                            "label": "Purchased vs. District Tank",
                                            "helpText": "Distinguish external purchases from district pump fills"
                                        },
                                        {
                                            "key": "track_vendor",
                                            "type": "checkbox",
                                            "label": "Track Vendor & Location",
                                            "helpText": "Where the fuel was purchased"
                                        },
                                        {
                                            "key": "track_receipts",
                                            "type": "checkbox",
                                            "label": "Allow Receipt Upload",
                                            "helpText": "PDF/image upload on fuel logs"
                                        }
                                    ]
                                },
                                {
                                    "title": "Maintenance — Optional Fields",
                                    "description": "Core fields (vehicle, date, maintenance type) are always visible.",
                                    "icon": "lucide-wrench",
                                    "grid": 2,
                                    "fields": [
                                        {
                                            "key": "enable_maintenance_tracking",
                                            "type": "checkbox",
                                            "label": "Enable Maintenance Module",
                                            "helpText": "Turn off to hide all maintenance features"
                                        },
                                        {
                                            "key": "enable_scheduling",
                                            "type": "checkbox",
                                            "label": "Enable Schedule Tracking",
                                            "helpText": "Track upcoming due dates for maintenance items"
                                        },
                                        {
                                            "key": "track_maintenance_cost",
                                            "type": "checkbox",
                                            "label": "Track Maintenance Cost",
                                            "helpText": "Record cost on maintenance events"
                                        },
                                        {
                                            "key": "track_parts_labor_split",
                                            "type": "checkbox",
                                            "label": "Split Parts & Labor",
                                            "helpText": "Separate parts and labor costs (requires cost tracking)",
                                            "showIf": {
                                                "field": "track_maintenance_cost",
                                                "equals": true
                                            }
                                        },
                                        {
                                            "key": "track_invoices",
                                            "type": "checkbox",
                                            "label": "Allow Invoice Upload",
                                            "helpText": "PDF/image upload on maintenance events"
                                        },
                                        {
                                            "key": "track_photos",
                                            "type": "checkbox",
                                            "label": "Allow Photo Upload",
                                            "helpText": "Upload photos of completed work"
                                        },
                                        {
                                            "key": "maintenance_lead_time_days",
                                            "type": "number",
                                            "label": "Lead Time (Days)",
                                            "helpText": "Notify this many days before service is due",
                                            "showIf": {
                                                "field": "enable_scheduling",
                                                "equals": true
                                            }
                                        },
                                        {
                                            "key": "maintenance_lead_distance_miles",
                                            "type": "number",
                                            "label": "Lead Distance (Miles)",
                                            "helpText": "Notify this many miles before service is due",
                                            "showIf": {
                                                "field": "enable_scheduling",
                                                "equals": true
                                            }
                                        }
                                    ]
                                },
                                {
                                    "title": "Vehicle Details — Optional Fields",
                                    "description": "Core fields (unit number, name, year, make, model) are always visible.",
                                    "icon": "lucide-truck",
                                    "grid": 2,
                                    "fields": [
                                        {
                                            "key": "track_vin",
                                            "type": "checkbox",
                                            "label": "Track VIN",
                                            "helpText": "Vehicle Identification Number"
                                        },
                                        {
                                            "key": "track_license_plate",
                                            "type": "checkbox",
                                            "label": "Track License Plate"
                                        },
                                        {
                                            "key": "track_vehicle_color",
                                            "type": "checkbox",
                                            "label": "Track Color"
                                        },
                                        {
                                            "key": "track_assigned_driver",
                                            "type": "checkbox",
                                            "label": "Track Assigned Driver",
                                            "helpText": "Default driver per vehicle"
                                        }
                                    ]
                                },
                                {
                                    "title": "Organization & Workflow",
                                    "icon": "lucide-settings",
                                    "grid": 2,
                                    "fields": [
                                        {
                                            "key": "enable_departments",
                                            "type": "checkbox",
                                            "label": "Enable Departments",
                                            "helpText": "Group vehicles by department"
                                        },
                                        {
                                            "key": "enable_campuses",
                                            "type": "checkbox",
                                            "label": "Enable Campuses",
                                            "helpText": "Assign vehicles to campuses"
                                        },
                                        {
                                            "key": "require_approval",
                                            "type": "checkbox",
                                            "label": "Require Approval",
                                            "helpText": "Enable Layer 2 manager approval workflow for logs"
                                        },
                                        {
                                            "key": "allow_driver_logging",
                                            "type": "checkbox",
                                            "label": "Allow Driver Logging",
                                            "helpText": "Let non-manager users submit fuel/maintenance logs"
                                        }
                                    ]
                                },
                                {
                                    "title": "Vehicle Sharing",
                                    "description": "Allow other Hub packages to reference your vehicle records (e.g., trip planning, asset tracking).",
                                    "icon": "lucide-share-2",
                                    "fields": [
                                        {
                                            "key": "share_vehicles",
                                            "type": "checkbox",
                                            "label": "Share Vehicles Cross-Package",
                                            "helpText": "Other packages can read vehicle data via vm_vehicles table"
                                        }
                                    ]
                                }
                            ]
                        }
                    }
                ]
            }
        }
    },
    "data": {
        "queries": {
            "getFleetStats": {
                "description": "Fleet dashboard statistics",
                "handler": "VehicleQueryHandler::getFleetStats",
                "type": "stats",
                "table": "vm_vehicles",
                "cache": 300,
                "aggregations": [
                    {
                        "key": "total_vehicles",
                        "function": "COUNT",
                        "column": "*"
                    },
                    {
                        "key": "in_service",
                        "function": "COUNT",
                        "column": "*",
                        "condition": "is_out_of_service = 0 AND is_deleted = 0"
                    },
                    {
                        "key": "out_of_service",
                        "function": "COUNT",
                        "column": "*",
                        "condition": "is_out_of_service = 1 AND is_deleted = 0"
                    }
                ],
                "softDelete": {
                    "column": "is_deleted",
                    "value": 0
                },
                "extra": {
                    "maintenance_due": {
                        "type": "subquery",
                        "sql": "SELECT COUNT(DISTINCT vs.vehicle_id) FROM vm_vehicle_schedules vs WHERE vs.is_active = 1 AND (vs.next_due_date <= CURDATE() OR vs.next_due_odometer <= (SELECT v.current_odometer FROM vm_vehicles v WHERE v.id = vs.vehicle_id))"
                    }
                }
            },
            "listVehicles": {
                "description": "List vehicles with search/filter/pagination",
                "handler": "VehicleQueryHandler::listVehicles",
                "type": "list",
                "table": "vm_vehicles",
                "columns": {
                    "id": "v.id",
                    "unit_number": "v.unit_number",
                    "display_name": "CONCAT(v.year, ' ', v.make, ' ', v.model)",
                    "vin": "v.vin",
                    "license_plate": "v.license_plate",
                    "current_odometer": "v.current_odometer",
                    "status_badge": "CASE WHEN v.is_out_of_service = 1 THEN 'Out of Service' ELSE 'Active' END",
                    "department_name": "d.name",
                    "is_out_of_service": "v.is_out_of_service"
                },
                "tableAlias": "v",
                "joins": [
                    {
                        "type": "LEFT",
                        "table": "vm_departments",
                        "alias": "d",
                        "on": "v.department_id = d.id"
                    }
                ],
                "softDelete": {
                    "column": "v.is_deleted",
                    "value": 0
                },
                "searchColumns": [
                    "v.unit_number",
                    "v.vin",
                    "v.make",
                    "v.model",
                    "v.license_plate",
                    "v.name"
                ],
                "filterColumns": {
                    "status": {
                        "column": "v.is_out_of_service",
                        "map": {
                            "active": 0,
                            "oos": 1
                        }
                    },
                    "department": {
                        "column": "v.department_id"
                    }
                },
                "defaultSort": {
                    "column": "v.unit_number",
                    "direction": "ASC"
                },
                "sortColumns": {
                    "unit_number": "v.unit_number",
                    "display_name": "v.year",
                    "current_odometer": "v.current_odometer"
                },
                "pagination": true,
                "parameters": {
                    "search": {
                        "type": "string",
                        "optional": true
                    },
                    "status": {
                        "type": "string",
                        "optional": true
                    },
                    "department": {
                        "type": "string",
                        "optional": true
                    },
                    "page": {
                        "type": "integer",
                        "optional": true
                    },
                    "pageSize": {
                        "type": "integer",
                        "optional": true
                    },
                    "sort": {
                        "type": "string",
                        "optional": true
                    },
                    "sortDir": {
                        "type": "string",
                        "optional": true
                    }
                }
            },
            "getVehicle": {
                "description": "Get a single vehicle by ID with department/campus info",
                "handler": "VehicleQueryHandler::getVehicle",
                "type": "get",
                "table": "vm_vehicles",
                "columns": {
                    "id": "v.id",
                    "unit_number": "v.unit_number",
                    "name": "v.name",
                    "vin": "v.vin",
                    "license_plate": "v.license_plate",
                    "year": "v.year",
                    "make": "v.make",
                    "model": "v.model",
                    "color": "v.color",
                    "current_odometer": "v.current_odometer",
                    "department_id": "v.department_id",
                    "department_name": "d.name",
                    "campus_id": "v.campus_id",
                    "campus_name": "c.name",
                    "assigned_driver_id": "v.assigned_driver_id",
                    "is_out_of_service": "v.is_out_of_service",
                    "out_of_service_reason": "v.out_of_service_reason",
                    "out_of_service_date": "v.out_of_service_date",
                    "is_shared": "v.is_shared",
                    "created_at": "v.created_at",
                    "updated_at": "v.updated_at"
                },
                "tableAlias": "v",
                "joins": [
                    {
                        "type": "LEFT",
