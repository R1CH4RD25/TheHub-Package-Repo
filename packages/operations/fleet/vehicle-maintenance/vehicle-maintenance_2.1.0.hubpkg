                    {
                        "type": "LEFT",
                        "table": "vm_campuses",
                        "alias": "c",
                        "on": "v.campus_id = c.id"
                    }
                ],
                "idColumn": "v.id",
                "parameters": {
                    "id": {
                        "type": "string",
                        "required": true
                    }
                }
            },
