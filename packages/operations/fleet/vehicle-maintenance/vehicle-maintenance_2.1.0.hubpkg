            "listSchedules": {
                "description": "List maintenance schedules with due status",
                "handler": "MaintenanceQueryHandler::listSchedules",
                "type": "list",
                "table": "vm_vehicle_schedules",
                "columns": {
                    "id": "vs.id",
                    "vehicle_unit": "v.unit_number",
                    "vehicle_name": "CONCAT(v.year, ' ', v.make, ' ', v.model)",
                    "vehicle_id": "vs.vehicle_id",
                    "maintenance_type": "mi.name",
                    "mileage_interval": "vs.mileage_interval",
                    "time_interval_days": "vs.time_interval_days",
                    "last_service_date": "vs.last_service_date",
                    "last_service_odometer": "vs.last_service_odometer",
                    "next_due_date": "vs.next_due_date",
                    "next_due_odometer": "vs.next_due_odometer",
                    "is_active": "vs.is_active",
                    "due_status": "CASE WHEN vs.next_due_date <= CURDATE() OR vs.next_due_odometer <= v.current_odometer THEN 'overdue' WHEN vs.next_due_date <= DATE_ADD(CURDATE(), INTERVAL 30 DAY) THEN 'upcoming' ELSE 'ok' END"
                },
                "tableAlias": "vs",
                "joins": [
                    {
                        "type": "LEFT",
                        "table": "vm_vehicles",
                        "alias": "v",
                        "on": "vs.vehicle_id = v.id"
                    },
                    {
                        "type": "LEFT",
                        "table": "vm_maintenance_items",
                        "alias": "mi",
                        "on": "vs.maintenance_item_id = mi.id"
                    }
                ],
                "where": "vs.is_active = 1",
                "searchColumns": [
                    "v.unit_number",
                    "v.make",
                    "v.model",
                    "mi.name"
                ],
                "filterColumns": {
                    "due_status": {
                        "type": "having",
                        "expression": "CASE WHEN vs.next_due_date <= CURDATE() OR vs.next_due_odometer <= v.current_odometer THEN 'overdue' WHEN vs.next_due_date <= DATE_ADD(CURDATE(), INTERVAL 30 DAY) THEN 'upcoming' ELSE 'ok' END"
                    }
                },
                "defaultSort": {
                    "column": "vs.next_due_date",
                    "direction": "ASC"
                },
                "pagination": true,
                "parameters": {
                    "search": {
                        "type": "string",
                        "optional": true
                    },
                    "due_status": {
                        "type": "string",
                        "optional": true
                    },
                    "page": {
                        "type": "integer",
                        "optional": true
                    },
                    "pageSize": {
                        "type": "integer",
                        "optional": true
                    }
                }
            },
            "listTripCategories": {
                "description": "List all trip categories for admin config",
                "handler": "VehicleQueryHandler::listTripCategories",
                "type": "list",
                "table": "vm_trip_categories",
                "columns": {
                    "id": "id",
                    "code": "code",
                    "name": "name",
                    "description": "description",
                    "is_active": "is_active",
                    "sort_order": "sort_order"
                },
                "defaultSort": {
                    "column": "sort_order",
                    "direction": "ASC"
                }
            },
