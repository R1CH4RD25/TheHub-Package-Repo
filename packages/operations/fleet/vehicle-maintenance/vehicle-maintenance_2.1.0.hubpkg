            "getFuelStats": {
                "description": "Fuel log dashboard stats",
                "handler": "FuelQueryHandler::getFuelStats",
                "type": "stats",
                "table": "vm_fuel_logs",
                "cache": 300,
                "aggregations": [
                    {
                        "key": "total_logs",
                        "function": "COUNT",
                        "column": "*"
                    },
                    {
                        "key": "total_gallons",
                        "function": "SUM",
                        "column": "gallons"
                    },
                    {
                        "key": "total_cost",
                        "function": "SUM",
                        "column": "total_cost"
                    },
                    {
                        "key": "pending_approval",
                        "function": "COUNT",
                        "column": "*",
                        "condition": "workflow_status IN ('submitted','in_review','resubmitted')"
                    }
                ]
            },
            "listFuelLogs": {
                "description": "List fuel logs with filters",
                "handler": "FuelQueryHandler::listFuelLogs",
                "type": "list",
                "table": "vm_fuel_logs",
                "columns": {
                    "id": "f.id",
                    "event_date": "f.event_date",
                    "vehicle_unit": "v.unit_number",
                    "vehicle_name": "CONCAT(v.year, ' ', v.make, ' ', v.model)",
                    "vehicle_id": "f.vehicle_id",
                    "trip_category": "tc.name",
                    "odometer": "f.odometer",
                    "gallons": "f.gallons",
                    "fuel_type": "f.fuel_type",
                    "total_cost": "f.total_cost",
                    "workflow_status": "f.workflow_status",
                    "logged_by": "f.logged_by",
                    "created_at": "f.created_at"
                },
                "tableAlias": "f",
                "joins": [
                    {
                        "type": "LEFT",
                        "table": "vm_vehicles",
                        "alias": "v",
                        "on": "f.vehicle_id = v.id"
                    },
                    {
                        "type": "LEFT",
                        "table": "vm_trip_categories",
                        "alias": "tc",
                        "on": "f.trip_category_id = tc.id"
                    }
                ],
                "searchColumns": [
                    "v.unit_number",
                    "v.make",
                    "v.model",
                    "f.vendor",
                    "f.notes"
                ],
                "filterColumns": {
                    "trip_category": {
                        "column": "f.trip_category_id"
                    },
                    "vehicle_id": {
                        "column": "f.vehicle_id"
                    },
                    "status": {
                        "column": "f.workflow_status",
                        "map": {
                            "pending": [
                                "submitted",
                                "in_review",
                                "resubmitted"
                            ],
                            "approved": [
                                "approved"
                            ],
                            "rejected": [
                                "rejected"
                            ],
                            "needs_correction": [
                                "needs_correction"
                            ]
                        }
                    }
                },
                "defaultSort": {
                    "column": "f.event_date",
                    "direction": "DESC"
                },
                "sortColumns": {
                    "event_date": "f.event_date",
                    "vehicle_unit": "v.unit_number",
                    "gallons": "f.gallons",
                    "total_cost": "f.total_cost"
                },
                "pagination": true,
                "parameters": {
                    "search": {
                        "type": "string",
                        "optional": true
                    },
                    "trip_category": {
                        "type": "string",
                        "optional": true
                    },
                    "vehicle_id": {
                        "type": "string",
                        "optional": true
                    },
                    "status": {
                        "type": "string",
                        "optional": true
                    },
                    "page": {
                        "type": "integer",
                        "optional": true
                    },
                    "pageSize": {
                        "type": "integer",
                        "optional": true
                    },
                    "sort": {
                        "type": "string",
                        "optional": true
                    },
                    "sortDir": {
                        "type": "string",
                        "optional": true
                    }
                }
            },
