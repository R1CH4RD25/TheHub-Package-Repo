                "aggregations": [
                    {
                        "key": "total_events",
                        "function": "COUNT",
                        "column": "*"
                    },
                    {
                        "key": "total_cost",
                        "function": "SUM",
                        "column": "total_cost"
                    },
                    {
                        "key": "pending_approval",
                        "function": "COUNT",
                        "column": "*",
                        "condition": "workflow_status IN ('submitted','in_review','resubmitted')"
                    },
                    {
                        "key": "avg_cost",
                        "function": "AVG",
                        "column": "total_cost"
                    }
                ]
            },
