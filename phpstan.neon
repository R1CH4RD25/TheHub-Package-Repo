parameters:
    level: 6
    paths:
        - src
        - public/api

    # Exclude directories
    excludePaths:
        - vendor
        - tests
        - temp
        - uploads
        - logs
        - sessions
        - backups

    # Bootstrap file for constants and functions
    bootstrapFiles:
        - src/bootstrap.php

    # Allow dynamic properties and unmatched ignored errors
    reportUnmatchedIgnoredErrors: false

    # Ignore specific errors
    ignoreErrors:
        # OAuth flow uses external APIs
        - '#Call to an undefined method Google\\.*#'
        # Session superglobal usage is intentional
        - '#Variable \$_SESSION.*might not be defined#'
        # Allow exit/die in Auth redirect methods
        - '#.*exit\(\).*#'
        - '#.*die\(\).*#'
        # Database dynamic queries (validated elsewhere)
        - '#.*PDO.*prepare.*#'

    # Custom rules for security patterns
    universalObjectCratesClasses:
        - stdClass

    # Parallel processing
    parallel:
        jobSize: 20
        maximumNumberOfProcesses: 4
        minimumNumberOfJobsPerProcess: 2
