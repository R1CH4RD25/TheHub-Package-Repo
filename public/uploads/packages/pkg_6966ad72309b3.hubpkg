  "permissions": {
    "roles": [
      {
        "key": "vrf_request",
        "displayName": "Submit Vehicle Requests",
        "description": "Can submit new vehicle requests."
      },
      {
        "key": "vrf_approve",
        "displayName": "Approve Vehicle Requests",
        "description": "Can review, assign vehicles, and approve or deny requests."
      },
      {
        "key": "vrf_report",
        "displayName": "View Vehicle Request Analytics",
        "description": "Can view analytics and export reports."
      },
      {
        "key": "vrf_admin",
        "displayName": "Vehicle Request Administrator",
        "description": "Full control over vehicle request configuration, vehicles list, and data."
      }
    ],
    "roleMatrix": {
      "vrf_request": [
        "module:vehicle-request-form:create",
        "module:vehicle-request-form:read"
      ],
      "vrf_approve": [
        "module:vehicle-requests-table:read",
        "module:vehicle-requests-table:update",
        "module:vehicles-table:read",
        "module:vehicle-request-approval:advance",
        "module:vehicle-request-emails:read"
      ],
      "vrf_report": [
        "module:vehicle-requests-table:read",
        "module:vehicle-requests-table:export",
        "module:vehicle-requests-analytics:read"
      ],
      "vrf_admin": [
        "module:vehicle-request-form:*",
        "module:vehicle-requests-table:*",
        "module:vehicles-table:*",
        "module:vehicle-request-approval:*",
        "module:vehicle-requests-analytics:*",
        "module:vehicle-request-emails:*"
      ]
    },
    "defaultAccess": {
      "staff": ["vrf_request"],
      "coach": ["vrf_request"],
      "teacher": ["vrf_request"],
      "principal": ["vrf_approve", "vrf_report"],
      "transportation_admin": ["vrf_approve", "vrf_report"],
      "super_admin": ["vrf_admin"]
    }
  },

  "menu_items": [
    {
      "label": "Request a Vehicle",
      "route": "/pkg/vrf/vehicle-request-form",
      "icon": "bi-truck",
      "order": 1,
      "minimum_role": "vrf_request"
    },
    {
      "label": "Vehicle Requests",
      "route": "/pkg/vrf/vehicle-requests",
      "icon": "bi-table",
      "order": 2,
      "minimum_role": "vrf_approve"
    },
    {
      "label": "Vehicle Analytics",
      "route": "/pkg/vrf/vehicle-analytics",
      "icon": "bi-graph-up",
      "order": 3,
      "minimum_role": "vrf_report"
    },
    {
      "label": "Manage Vehicles",
      "route": "/pkg/vrf/vehicles",
      "icon": "bi-gear",
      "order": 4,
      "minimum_role": "vrf_admin"
    }
  ]
}
