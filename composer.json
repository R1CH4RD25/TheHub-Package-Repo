{
    "name": "thehub/core",
    "description": "The Hub - Modular Web Application Platform",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "vlucas/phpdotenv": "^5.5",
        "phpoffice/phpspreadsheet": "^1.29",
        "phpmailer/phpmailer": "^7.0",
        "google/apiclient": "^2.0",
        "monolog/monolog": "^3.5",
        "symfony/http-foundation": "^7.0",
        "symfony/console": "^7.0",
        "symfony/validator": "^7.0",
        "symfony/cache": "^7.0",
        "league/csv": "^9.15",
        "ramsey/uuid": "^4.7",
        "nesbot/carbon": "^3.0",
        "guzzlehttp/guzzle": "^7.8",
        "intervention/image": "^3.5",
        "league/flysystem": "^3.23",
        "spatie/image-optimizer": "^1.7",
        "barryvdh/laravel-dompdf": "^2.2",
        "tecnickcom/tcpdf": "^6.7",
        "erusev/parsedown": "^1.7",
        "michelf/php-markdown": "^2.0",
        "mpdf/mpdf": "^8.2",
        "twig/twig": "^3.8",
        "symfony/yaml": "^7.0",
        "firebase/php-jwt": "^6.10",
        "paragonie/sodium_compat": "^2.0",
        "defuse/php-encryption": "^2.4",
        "bacon/bacon-qr-code": "^2.0",
        "endroid/qr-code": "^5.0",
        "egulias/email-validator": "^4.0",
        "doctrine/dbal": "^4.0",
        "respect/validation": "^2.3",
        "league/commonmark": "^2.4",
        "mobiledetect/mobiledetectlib": "^4.8",
        "predis/predis": "^3.2",
        "spatie/laravel-query-builder": "^6.4",
        "spatie/laravel-data": "^4.19",
        "opis/json-schema": "^2.6",
        "spatie/laravel-activitylog": "^4.11",
        "maatwebsite/excel": "^3.1"
    },
    "config": {
        "process-timeout": 0,
        "discard-changes": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Hub\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hub\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "laravel/telescope": "^5.17"
    }
}
